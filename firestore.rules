rules_version = '2';

// Each signed-in user gets exactly one document, at users/{their-uid},
// holding their settings, saved clients, and invoice history. Only that
// same user (proven via Firebase Authentication) can read or write it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
